#!/bin/sh
# wherdr installer — https://wherdr.dev/install
#
#   curl -fsSL https://wherdr.dev/install | sh
#
# One command on macOS and Linux, run on the computer that runs Herdr, as the
# user who runs it. wherdr runs natively, as that user: the only setup where
# the herdr-projects Board can act (start, stop, reply, approve, Coordinator).
# It:
#   1. checks Herdr (and stops with its install link when it is missing);
#   2. leaves alone a wherdr that already runs (and offers its update);
#   3. makes sure Node.js 22 (or Bun) is there; without it, it offers
#      `brew install node` (macOS with Homebrew) or the official Node.js
#      download into ~/wherdr/node (checksum checked, no sudo), asked first;
#   4. installs the wherdr Herdr plugin (herdr plugin install afloury/wherdr),
#      which downloads the verified GitHub release package into ~/wherdr/app,
#      starts it, opens its setup guide in your browser and adds a Herdr key
#      for its panel;
#   5. starts wherdr at login: a systemd --user unit with lingering on Linux
#      (it keeps running after you log out), a LaunchAgent on macOS;
#   6. on a server without a screen (or over SSH): prints the address and the
#      phone steps instead of opening a browser.
# It never uses sudo and never stops or replaces a wherdr started another way.
#
# Settings (environment variables):
#   WHERDR_SERVICE=off  no login service: wherdr starts with Herdr only
#   WHERDR_DIR    install folder                (default: ~/wherdr)
#   WHERDR_PORT   local port                    (default: 7683)
#   WHERDR_YES=1  answer yes to every question  (non-interactive use)
#   WHERDR_NO_BROWSER=1  never open a browser
#   WHERDR_SKILL=off  skip agent skill installation and refresh
#   WHERDR_REF    Git tag or branch of the plugin (default: main)
#   WHERDR_PLUGIN a local checkout to install instead of afloury/wherdr (development)
#
# Source: https://github.com/afloury/wherdr/blob/main/website/public/install

# Everything is inside main(), called on the last line: a download cut short
# runs nothing.
main() {
  set -eu

  REPO="afloury/wherdr"
  PLUGIN_ID="afloury.wherdr"
  PLUGIN="${WHERDR_PLUGIN:-$REPO}"
  REF="${WHERDR_REF:-main}"
  DIR="${WHERDR_DIR:-$HOME/wherdr}"
  case "$DIR" in /*) ;; *) DIR="$PWD/$DIR" ;; esac
  PORT="${WHERDR_PORT:-7683}"
  URL="http://localhost:$PORT"
  YES="${WHERDR_YES:-0}"

  setup_colors
  say ""
  say "${B}wherdr${R} ${D}installer — your Herdr agents, from your phone and your browser${R}"

  # ---------------------------------------------------------------- checks
  step "Checking the system"
  OS="$(uname -s)"
  case "$OS" in
    Linux) ok "Linux $(uname -m)" ;;
    Darwin) ok "macOS $(sw_vers -productVersion 2>/dev/null || uname -r)" ;;
    *) die "Unsupported system: $OS. wherdr runs on macOS and Linux." ;;
  esac
  if [ "$(id -u)" = "0" ]; then
    die "Run this script as the user who runs Herdr, not as root.
     wherdr reads that user's Herdr socket and transcripts."
  fi
  [ -n "${HOME:-}" ] && [ -d "$HOME" ] || die "\$HOME is not set or not a folder."
  if command -v curl >/dev/null 2>&1; then FETCH="curl"
  elif command -v wget >/dev/null 2>&1; then FETCH="wget"
  else die "curl or wget is required."
  fi

  HERDR="$(find_herdr)" || die "Herdr is not installed for $(id -un). wherdr drives Herdr: install it first,
     then run this command again:
       ${C}https://herdr.dev${R}"
  HERDR_VERSION="$("$HERDR" --version 2>/dev/null | awk '{print $NF}')"
  if version_lt "${HERDR_VERSION:-0}" "0.9.1"; then
    die "Herdr ${HERDR_VERSION:-?} found at $HERDR; wherdr needs Herdr 0.9.1 or newer (herdr update)."
  fi
  ok "Herdr $HERDR_VERSION ($HERDR)"
  SOCK="${HERDR_SOCKET_PATH:-$HOME/.config/herdr/herdr.sock}"
  if [ ! -S "$SOCK" ]; then
    warn "The Herdr server does not seem to run (no $SOCK).
     Start it with \`herdr\` or \`herdr server\`; wherdr waits for it."
  fi

  # ------------------------------------------------------- existing wherdr
  PLUGIN_ROOT="$(plugin_root)"
  if answers; then
    existing_wherdr
    return 0
  fi
  # The plugin opens the setup guide on its first install only (no plugin.env).
  FIRST=1
  [ ! -f "$DIR/plugin.env" ] || FIRST=0
  if [ -n "$PLUGIN_ROOT" ]; then
    ok "wherdr plugin already installed: updating it and starting wherdr"
  fi

  # ---------------------------------------------------------------- runtime
  RUNTIME=""
  if RUNTIME="$(find_runtime)"; then
    ver="$("$RUNTIME" --version 2>/dev/null || true)"
    ok "Runtime: $RUNTIME ($ver)"
  else
    no_runtime
  fi

  # -------------------------------------------------------------- headless
  BROWSER=1
  if [ "${WHERDR_NO_BROWSER:-0}" = "1" ] || [ -n "${SSH_CONNECTION:-}${SSH_TTY:-}" ]; then BROWSER=0
  elif [ "$OS" = "Linux" ] && [ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then BROWSER=0
  fi

  # ---------------------------------------------------------------- plugin
  step "Installing the wherdr Herdr plugin"
  # Herdr's own output (the manifest preview) is kept for a failure; the
  # plugin shows its progress on the terminal itself.
  LOG="$(mktemp)"
  trap 'rm -f "$LOG"' EXIT INT TERM
  if ! plugin_install >"$LOG" 2>&1; then
    sed 's/^/     /' "$LOG" >&2
    die "The plugin install failed. Its log: herdr plugin log list --plugin $PLUGIN_ID"
  fi
  PLUGIN_ROOT="$(plugin_root)"
  ok "Herdr plugin $PLUGIN_ID installed"

  i=0
  while [ "$i" -lt 60 ] && ! answers; do i=$((i + 1)); sleep 1; done
  if ! answers; then
    die "wherdr is installed but does not answer on port $PORT.
     In Herdr, open the wherdr panel and press L for its log,
     or: herdr plugin log list --plugin $PLUGIN_ID"
  fi
  ok "wherdr answers on $URL"

  # --------------------------------------------------------------- service
  install_service

  # ------------------------------------------------------------------ next
  # Already published on the tailnet and answering: that address is the one
  # to use (passkeys are tied to it); the plugin opened the guide there.
  ADDRESS="$(plugin_address)"
  say ""
  say "${G}${B}✓ wherdr is running${R}"
  say "  On this computer: ${B}$URL${R}"
  key="$(panel_key)"
  if [ -n "$key" ]; then
    say "  In Herdr, ${B}$key${R} opens the wherdr panel."
  else
    say "  In Herdr: herdr plugin action invoke panel --plugin $PLUGIN_ID"
  fi
  if [ "$ADDRESS" != "$URL" ]; then
    say "  On your phone: ${B}$ADDRESS${R} (Tailscale, private network only)."
    say "  Enable the passkey lock there (Settings › Security): a passkey is tied to its address."
  elif [ "$BROWSER" = "1" ] && [ "$FIRST" = "1" ]; then
    say "  The setup guide is open in your browser."
    say "  Phone: follow its Phone step to set up Tailscale (private network only)."
  elif [ "$BROWSER" = "1" ]; then
    say "  Phone: open Settings › Phone in your browser to set up Tailscale (private network only)."
  else
    say "  No screen here: open the local address from this machine, or use an SSH tunnel:"
    say "    ${C}ssh -L $PORT:127.0.0.1:$PORT $(id -un)@$(hostname 2>/dev/null || echo this-server)${R}"
    phone_steps
  fi
  say ""
  say "${D}Update: run this command again, or U in the wherdr panel.${R}"
  say "${D}Docs:   https://github.com/$REPO/blob/main/docs/installation.md${R}"
}

# The address the plugin opens: the tailnet one when wherdr is already
# published there and it answers, else the local one.
plugin_address() {
  a=""
  if [ -n "$PLUGIN_ROOT" ] && [ -f "$PLUGIN_ROOT/scripts/herdr-plugin.sh" ]; then
    a="$(WHERDR_DIR="$DIR" WHERDR_PORT="$PORT" sh "$PLUGIN_ROOT/scripts/herdr-plugin.sh" address 2>/dev/null || true)"
  fi
  case "$a" in https://*) printf '%s' "$a" ;; *) printf '%s' "$URL" ;; esac
}

# The Herdr key the plugin bound to its panel, empty when there is none.
panel_key() {
  [ -n "$PLUGIN_ROOT" ] && [ -f "$PLUGIN_ROOT/scripts/herdr-plugin.sh" ] || return 0
  k="$(WHERDR_DIR="$DIR" sh "$PLUGIN_ROOT/scripts/herdr-plugin.sh" key status 2>/dev/null || true)"
  [ "$k" = "none" ] || printf '%s' "$k"
}

# ------------------------------------------------------------ plugin path
find_herdr() {
  if [ -n "${HERDR_BIN:-}" ] && [ -x "$HERDR_BIN" ]; then echo "$HERDR_BIN"
  elif [ -x "$HOME/.local/bin/herdr" ]; then echo "$HOME/.local/bin/herdr"
  elif command -v herdr >/dev/null 2>&1; then command -v herdr
  else return 1
  fi
}

# Folder of the installed wherdr plugin, empty when it is not installed.
plugin_root() {
  "$HERDR" plugin list --plugin "$PLUGIN_ID" --json 2>/dev/null \
    | sed -n 's/.*"plugin_root":"\([^"]*\)".*/\1/p' | head -n 1
}

# Herdr installs the plugin and runs its build (scripts/herdr-plugin.sh build),
# which downloads and verifies the GitHub release package (no npm publication wait).
# It reads these variables. A local checkout (WHERDR_PLUGIN=/path) is linked
# and built in place instead.
plugin_install() {
  set -- env WHERDR_INSTALLER=1 WHERDR_DIR="$DIR" WHERDR_PORT="$PORT"
  [ -z "$RUNTIME" ] || set -- "$@" WHERDR_RUNTIME="$RUNTIME"
  [ "$BROWSER" = "1" ] || set -- "$@" WHERDR_NO_BROWSER=1
  if [ -d "$PLUGIN" ]; then
    "$HERDR" plugin link "$PLUGIN" >/dev/null || return 1
    ok "Plugin linked from $PLUGIN"
    "$@" sh "$PLUGIN/scripts/herdr-plugin.sh" build
  else
    "$@" "$HERDR" plugin install "$PLUGIN" --ref "$REF" --yes
  fi
}

# Something answers on the port: never replaced. A wherdr of the plugin, or
# can be updated; anything else is left as is.
existing_wherdr() {
  if ! is_wherdr; then
    die "Port $PORT is already used by another program.
     Pick another port: curl -fsSL https://wherdr.dev/install | WHERDR_PORT=7684 sh"
  fi
  ok "wherdr already runs on $URL"
  if [ -n "$PLUGIN_ROOT" ]; then
    say "  Installed as a Herdr plugin."
    if confirm "Update it now (herdr plugin install $REPO)?"; then
      step "Updating the wherdr Herdr plugin"
      RUNTIME="" BROWSER=0
      log="$(mktemp)"
      if ! plugin_install >"$log" 2>&1; then
        sed 's/^/     /' "$log" >&2; rm -f "$log"
        die "The update failed. Its log: herdr plugin log list --plugin $PLUGIN_ID"
      fi
      rm -f "$log"
      ok "wherdr updated"
    else
      say "  Update later: U in the wherdr panel, or run this command again."
    fi
    install_service
    say ""
    say "  On this machine: ${B}$URL${R}"
    phone_steps
    return 0
  else
    say "  It was installed another way (npm, Homebrew, by hand): nothing changed."
    say "  Update it the same way: https://github.com/$REPO/blob/main/docs/installation.md#updating"
    say "  A wherdr 1.x Docker container? wherdr 2.0 runs natively only; move it:"
    say "  https://github.com/$REPO/blob/main/docs/herdr-projects-1x.md#moving-from-docker-to-the-native-service"
    say "  Phone: ${C}wherdr phone${R} (or ${C}npx wherdr phone${R}) checks the address your phone opens."
  fi
  say ""
  say "  Open ${B}$URL${R}"
}

# The headless end of the install: the phone steps of the plugin
# (`wherdr phone`: Tailscale state, the address, the QR code once it answers).
phone_steps() {
  say ""
  if [ -n "$PLUGIN_ROOT" ] && [ -f "$PLUGIN_ROOT/scripts/herdr-plugin.sh" ]; then
    WHERDR_DIR="$DIR" sh "$PLUGIN_ROOT/scripts/herdr-plugin.sh" phone || true
  else
    say "  Phone: wherdr phone (in the wherdr panel: P)."
  fi
}

# No Node.js 22, no Bun. macOS with Homebrew: `brew install node`. Otherwise
# (or brew declined): the official Node.js 22 build from nodejs.org, unpacked
# into $DIR/node, its checksum checked. Asked first; no sudo, no PATH change:
# only wherdr uses it (its absolute path is saved by the plugin).
no_runtime() {
  warn "wherdr needs Node.js 22 or newer (or Bun), and none was found."
  if [ "$OS" = "Darwin" ] && command -v brew >/dev/null 2>&1 \
    && confirm "Install Node.js with Homebrew now (brew install node)?"; then
    brew install node || die "brew install node failed."
    RUNTIME="$(find_runtime)" || die "Node.js was installed but is not found: open a new terminal and run this command again."
    ok "Runtime: $RUNTIME ($("$RUNTIME" --version 2>/dev/null || true))"
    return 0
  fi
  if node_target >/dev/null; then
    if confirm "Download Node.js 22 from nodejs.org into $DIR/node (checksum checked, no sudo; used by wherdr only, your PATH is not changed)?"; then
      install_node
      return 0
    fi
    die "Install Node.js 22 or newer, then run this command again:
       https://nodejs.org/en/download (nvm, fnm, Homebrew or your package manager)
     Or let this script download it into $DIR/node:
       ${C}curl -fsSL https://wherdr.dev/install | WHERDR_YES=1 sh${R}"
  fi
  die "Install Node.js 22 or newer, then run this command again:
       https://nodejs.org/en/download (or your package manager: apk add nodejs on Alpine)"
}

# "<os>-<arch>" of the official Node.js build for this machine; fails where
# there is none (musl libc, an unknown processor).
node_target() {
  case "$OS" in
    Linux)
      if ldd --version 2>&1 | grep -qi musl; then return 1; fi
      nos=linux ;;
    Darwin) nos=darwin ;;
    *) return 1 ;;
  esac
  case "$(uname -m)" in
    x86_64|amd64) narch=x64 ;;
    aarch64|arm64) narch=arm64 ;;
    *) return 1 ;;
  esac
  printf '%s-%s\n' "$nos" "$narch"
}

sha256_of() {
  { sha256sum "$1" 2>/dev/null || shasum -a 256 "$1" 2>/dev/null; } | awk '{print $1}'
}

# Latest Node.js 22 into $DIR/node; sets RUNTIME.
install_node() {
  target="$(node_target)" || die "No official Node.js build for this system: install it from https://nodejs.org."
  dist="${WHERDR_NODE_DIST:-https://nodejs.org/dist}/latest-v22.x"
  step "Downloading Node.js 22 ($target) from ${dist%/latest-v22.x}"
  work="$(mktemp -d)"
  download "$dist/SHASUMS256.txt" "$work/SHASUMS256.txt" || { rm -rf "$work"; die "Could not download $dist/SHASUMS256.txt."; }
  file="$(awk -v t="$target" '$2 ~ ("^node-v22\\.[0-9.]+-" t "\\.tar\\.gz$") { print $2; exit }' "$work/SHASUMS256.txt")"
  sum="$(awk -v f="$file" '$2 == f { print $1; exit }' "$work/SHASUMS256.txt")"
  [ -n "$file" ] && [ -n "$sum" ] || { rm -rf "$work"; die "No Node.js 22 build for $target at $dist."; }
  download "$dist/$file" "$work/$file" || { rm -rf "$work"; die "Could not download $dist/$file."; }
  got="$(sha256_of "$work/$file")"
  if [ -z "$got" ] || [ "$got" != "$sum" ]; then
    rm -rf "$work"
    die "The Node.js download does not match its checksum: nothing installed. Try again later."
  fi
  ok "$file (checksum matched)"
  mkdir -p "$work/x" && tar -xzf "$work/$file" -C "$work/x" || { rm -rf "$work"; die "Could not unpack $file."; }
  unpacked="$(find "$work/x" -mindepth 1 -maxdepth 1 -type d | head -n 1)"
  [ -x "$unpacked/bin/node" ] || { rm -rf "$work"; die "$file holds no bin/node."; }
  mkdir -p "$DIR"
  rm -rf "$DIR/node.old"
  if [ -d "$DIR/node" ]; then mv "$DIR/node" "$DIR/node.old"; fi
  mv "$unpacked" "$DIR/node"
  rm -rf "$DIR/node.old" "$work"
  RUNTIME="$DIR/node/bin/node"
  [ "$("$RUNTIME" -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)" -ge 22 ] 2>/dev/null \
    || die "The downloaded Node.js does not run here ($RUNTIME): install it from https://nodejs.org."
  ok "Node.js $("$RUNTIME" --version 2>/dev/null) in $DIR/node"
  say "  Used by wherdr only: your PATH is not changed. It goes with the wherdr folder."
}

# The login service file `wherdr service install` writes.
service_file() {
  if [ "$OS" = "Darwin" ]; then echo "$HOME/Library/LaunchAgents/dev.wherdr.plist"
  else echo "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/wherdr.service"
  fi
}

# Starts wherdr at login, through the plugin (wherdr service install, from
# $DIR/app with the saved runtime and the user's PATH). Linux: a systemd --user
# unit and lingering (logind allows it for one's own user without sudo), so
# wherdr keeps running after logout; macOS: a LaunchAgent. A failure leaves
# wherdr running with Herdr (the plugin's startup hook), and says so.
install_service() {
  if [ "${WHERDR_SERVICE:-on}" = "off" ]; then
    say "  Login service skipped (WHERDR_SERVICE=off): wherdr starts with Herdr."
    return 0
  fi
  [ -n "$PLUGIN_ROOT" ] && [ -f "$PLUGIN_ROOT/scripts/herdr-plugin.sh" ] || return 0
  # Installed again on every run, an existing one too: it takes the PATH the
  # login shell gives now (agents installed since), and repairs a broken one.
  if [ -f "$(service_file)" ]; then step "Updating the login service"; else step "Starting wherdr at login"; fi
  if [ "$OS" = "Darwin" ]; then
    say "  A LaunchAgent ($(service_file)): wherdr starts at login and restarts if it stops."
  else
    say "  A systemd --user unit ($(service_file)), and lingering (loginctl enable-linger):"
    say "  wherdr starts with the machine, restarts if it stops and keeps running after you log out."
  fi
  if out="$(WHERDR_DIR="$DIR" WHERDR_PORT="$PORT" sh "$PLUGIN_ROOT/scripts/herdr-plugin.sh" service install 2>&1)"; then
    printf '%s\n' "$out" | sed 's/^ */     /'
    ok "Login service installed"
    return 0
  fi
  printf '%s\n' "$out" | tail -n 6 | sed 's/^ */     /' >&2
  # The install stopped wherdr for the service to take over: running again
  # before anything says it runs.
  if ! answers; then
    WHERDR_DIR="$DIR" WHERDR_PORT="$PORT" sh "$PLUGIN_ROOT/scripts/herdr-plugin.sh" start >/dev/null 2>&1 || true
    i=0
    while [ "$i" -lt 45 ] && ! answers; do i=$((i + 1)); sleep 1; done
  fi
  answers || die "The login service could not be installed, and wherdr does not answer on port $PORT.
     In Herdr, open the wherdr panel and press S to start it, or L for its log."
  warn "No login service: wherdr runs, and starts with Herdr. Try again later:
     sh $PLUGIN_ROOT/scripts/herdr-plugin.sh service install"
}

# Node.js 22 or newer, or Bun: WHERDR_RUNTIME, the one a previous install
# saved in plugin.env, the PATH, the Node.js this script installed in
# $DIR/node, then the usual install folders (n, nvm, Volta, fnm, asdf,
# Homebrew, Bun).
find_runtime() {
  saved="$(sed -n 's/^WHERDR_RUNTIME=//p' "$DIR/plugin.env" 2>/dev/null | tail -n 1)"
  # ls | sort: the newest version first (paths under $HOME have no spaces to split).
  # shellcheck disable=SC2012
  for c in "${WHERDR_RUNTIME:-}" "$saved" "$(command -v node 2>/dev/null || true)" "$DIR/node/bin/node" \
    "$HOME/.n/bin/node" $(ls -d "$HOME"/.nvm/versions/node/v*/bin/node 2>/dev/null | sort -r) \
    "$HOME/.volta/bin/node" \
    $(ls -d "$HOME"/.local/share/fnm/node-versions/*/installation/bin/node "$HOME"/.fnm/node-versions/*/installation/bin/node 2>/dev/null | sort -r) \
    "$HOME/.asdf/shims/node" /opt/homebrew/bin/node /usr/local/bin/node /usr/bin/node \
    "$(command -v bun 2>/dev/null || true)" "$HOME/.bun/bin/bun" /opt/homebrew/bin/bun /usr/local/bin/bun; do
    [ -n "$c" ] && [ -x "$c" ] && [ ! -d "$c" ] || continue
    case "$(basename "$c")" in
      bun) if "$c" --version >/dev/null 2>&1; then echo "$c"; return 0; fi ;;
      *) if [ "$("$c" -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)" -ge 22 ] 2>/dev/null; then echo "$c"; return 0; fi ;;
    esac
  done
  return 1
}

# ------------------------------------------------------------- helpers
setup_colors() {
  if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    B="$(printf '\033[1m')"; D="$(printf '\033[2m')"; R="$(printf '\033[0m')"
    G="$(printf '\033[32m')"; Y="$(printf '\033[33m')"; E="$(printf '\033[31m')"; C="$(printf '\033[36m')"
  else
    B=""; D=""; R=""; G=""; Y=""; E=""; C=""
  fi
}
say() { printf '%s\n' "$*"; }
step() { printf '\n%s==>%s %s%s%s\n' "$C" "$R" "$B" "$*" "$R"; }
ok() { printf '  %s✓%s %s\n' "$G" "$R" "$*"; }
warn() { printf '  %s⚠%s %s\n' "$Y" "$R" "$*" >&2; }
die() { printf '\n  %s✗ %s%s\n\n' "$E" "$*" "$R" >&2; exit 1; }

# Questions read the terminal: stdin is the script itself with `curl … | sh`.
# No terminal and no WHERDR_YES: the answer is no (nothing is changed).
confirm() {
  if [ "$YES" = "1" ]; then return 0; fi
  # In a subshell: a failed redirection on a special builtin would exit the script.
  if ! (exec </dev/tty) 2>/dev/null; then
    warn "$1 — no terminal to ask, answering no (set WHERDR_YES=1 to accept)."
    return 1
  fi
  printf '  ? %s [y/N] ' "$1" >/dev/tty
  read -r answer </dev/tty || answer=""
  case "$answer" in [yY]|[yY][eE][sS]) return 0 ;; *) return 1 ;; esac
}
download() {
  if [ "$FETCH" = "curl" ]; then curl -fsSL "$1" -o "$2"; else wget -q -O "$2" "$1"; fi
}
# Any HTTP answer counts (a locked wherdr answers 401): the port is taken.
answers() {
  if [ "$FETCH" = "curl" ]; then
    code="$(curl -s -o /dev/null --max-time 2 -w '%{http_code}' "http://127.0.0.1:$PORT/" 2>/dev/null || true)"
    [ -n "$code" ] && [ "$code" != "000" ]
  else
    # wget fails on an error status (and its exit code varies): read the status line.
    wget -S -q -O /dev/null -T 2 "http://127.0.0.1:$PORT/" 2>&1 | grep -q 'HTTP/[0-9.]* [0-9]'
  fi
}
# The web app manifest names wherdr (it is served without a session).
is_wherdr() {
  if [ "$FETCH" = "curl" ]; then
    curl -fs --max-time 3 "http://127.0.0.1:$PORT/manifest.webmanifest" 2>/dev/null | grep -q '"wherdr"'
  else
    wget -q -O - -T 3 "http://127.0.0.1:$PORT/manifest.webmanifest" 2>/dev/null | grep -q '"wherdr"'
  fi
}

# version_lt A B: true when version A < B (numeric dot-separated parts).
version_lt() {
  [ "$1" = "$2" ] && return 1
  lowest="$(printf '%s\n%s\n' "$1" "$2" | sort -t. -k1,1n -k2,2n -k3,3n | head -n 1)"
  [ "$lowest" = "$1" ]
}

main "$@"
