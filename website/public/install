#!/bin/sh
# wherdr installer — https://wherdr.dev/install
#
#   curl -fsSL https://wherdr.dev/install | sh
#
# One command on macOS and Linux, run on the computer that runs Herdr. It:
#   1. checks Herdr (and stops with its install link when it is missing);
#   2. leaves alone a wherdr that already runs (and offers its update);
#   3. makes sure wherdr can run: Node.js 22 or Bun, or Docker on Linux
#      (on macOS without Node.js, it offers `brew install node`);
#   4. installs the wherdr Herdr plugin (herdr plugin install afloury/wherdr),
#      which installs wherdr in ~/wherdr, starts it, opens its setup guide in
#      your browser and adds a Herdr key for its panel;
#   5. on a server without a screen (or over SSH): prints the address and the
#      phone steps instead of opening a browser.
# It never uses sudo and never stops or replaces a wherdr started another way.
#
# Settings (environment variables):
#   WHERDR_MODE=docker  no plugin: Docker Compose by hand in WHERDR_DIR (Linux)
#   WHERDR_MODE=native  plugin with Node.js even when Docker is there (Linux)
#   WHERDR_DIR    install folder                (default: ~/wherdr)
#   WHERDR_PORT   local port                    (default: 7683)
#   WHERDR_YES=1  answer yes to every question  (non-interactive use)
#   WHERDR_NO_BROWSER=1  never open a browser
#   WHERDR_REF    Git tag or branch of the plugin / compose file (default: latest)
#   WHERDR_IMAGE  Docker image, WHERDR_MODE=docker (default: ghcr.io/afloury/wherdr:latest)
#   WHERDR_PLUGIN a local checkout to install instead of afloury/wherdr (development)
#
# Source: https://github.com/afloury/wherdr/blob/main/website/public/install

# Everything is inside main(), called on the last line: a download cut short
# runs nothing.
main() {
  set -eu

  REPO="afloury/wherdr"
  PLUGIN_ID="afloury.wherdr"
  PLUGIN="${WHERDR_PLUGIN:-$REPO}"
  REF="${WHERDR_REF:-}"
  MODE="${WHERDR_MODE:-}"
  DIR="${WHERDR_DIR:-$HOME/wherdr}"
  PORT="${WHERDR_PORT:-7683}"
  URL="http://localhost:$PORT"
  YES="${WHERDR_YES:-0}"

  setup_colors
  say ""
  say "${B}wherdr${R} ${D}installer — your Herdr agents, from your phone and your browser${R}"

  # ---------------------------------------------------------------- checks
  step "Checking the system"
  OS="$(uname -s)"
  case "$OS" in
    Linux) ok "Linux $(uname -m)" ;;
    Darwin) ok "macOS $(sw_vers -productVersion 2>/dev/null || uname -r)" ;;
    *) die "Unsupported system: $OS. wherdr runs on macOS and Linux." ;;
  esac
  case "$MODE" in
    ""|native|docker) ;;
    *) die "WHERDR_MODE must be docker or native (got: $MODE)." ;;
  esac
  if [ "$(id -u)" = "0" ]; then
    die "Run this script as the user who runs Herdr, not as root.
     wherdr reads that user's Herdr socket and transcripts."
  fi
  [ -n "${HOME:-}" ] && [ -d "$HOME" ] || die "\$HOME is not set or not a folder."
  if command -v curl >/dev/null 2>&1; then FETCH="curl"
  elif command -v wget >/dev/null 2>&1; then FETCH="wget"
  else die "curl or wget is required."
  fi

  HERDR="$(find_herdr)" || die "Herdr is not installed for $(id -un). wherdr drives Herdr: install it first,
     then run this command again:
       ${C}https://herdr.dev${R}"
  HERDR_VERSION="$("$HERDR" --version 2>/dev/null | awk '{print $NF}')"
  if version_lt "${HERDR_VERSION:-0}" "0.9.1"; then
    die "Herdr ${HERDR_VERSION:-?} found at $HERDR; wherdr needs Herdr 0.9.1 or newer (herdr update)."
  fi
  ok "Herdr $HERDR_VERSION ($HERDR)"
  SOCK="${HERDR_SOCKET_PATH:-$HOME/.config/herdr/herdr.sock}"
  if [ ! -S "$SOCK" ]; then
    warn "The Herdr server does not seem to run (no $SOCK).
     Start it with \`herdr\` or \`herdr server\`; wherdr waits for it."
  fi

  if [ "$MODE" = "docker" ]; then
    [ "$OS" = "Linux" ] || die "WHERDR_MODE=docker is for Linux: on macOS, Docker Desktop cannot reach Herdr's socket.
     Run the command without WHERDR_MODE: wherdr then runs with Node.js."
    docker_install
    return 0
  fi

  # ------------------------------------------------------- existing wherdr
  PLUGIN_ROOT="$(plugin_root)"
  if answers; then
    existing_wherdr
    return 0
  fi
  if [ "$MODE" != "native" ] && container_elsewhere; then
    die "A \"wherdr\" Docker container already exists, managed from $(container_dir).
     Start or update it from there; this script does not install a second wherdr."
  fi
  # The plugin opens the setup guide on its first install only (no plugin.env).
  FIRST=1
  [ ! -f "$DIR/plugin.env" ] || FIRST=0
  if [ -n "$PLUGIN_ROOT" ]; then
    ok "wherdr plugin already installed: updating it and starting wherdr"
  fi

  # ---------------------------------------------------------------- runtime
  RUNTIME=""
  CONTAINER=0
  if [ "$OS" = "Linux" ] && [ "$MODE" != "native" ] && docker_usable; then
    CONTAINER=1
    ok "Docker $(docker version --format '{{.Server.Version}}' 2>/dev/null || echo '?'): wherdr runs in a container"
  elif RUNTIME="$(find_runtime)"; then
    ver="$("$RUNTIME" --version 2>/dev/null || true)"
    ok "Runtime: $RUNTIME ($ver)"
  else
    no_runtime
  fi

  # -------------------------------------------------------------- headless
  BROWSER=1
  if [ "${WHERDR_NO_BROWSER:-0}" = "1" ] || [ -n "${SSH_CONNECTION:-}${SSH_TTY:-}" ]; then BROWSER=0
  elif [ "$OS" = "Linux" ] && [ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then BROWSER=0
  fi

  # ---------------------------------------------------------------- plugin
  step "Installing the wherdr Herdr plugin"
  # Herdr's own output (the manifest preview) is kept for a failure; the
  # plugin shows its progress on the terminal itself.
  LOG="$(mktemp)"
  trap 'rm -f "$LOG"' EXIT INT TERM
  if ! plugin_install >"$LOG" 2>&1; then
    sed 's/^/     /' "$LOG" >&2
    die "The plugin install failed. Its log: herdr plugin log list --plugin $PLUGIN_ID"
  fi
  PLUGIN_ROOT="$(plugin_root)"
  ok "Herdr plugin $PLUGIN_ID installed"

  i=0
  while [ "$i" -lt 60 ] && ! answers; do i=$((i + 1)); sleep 1; done
  if ! answers; then
    die "wherdr is installed but does not answer on port $PORT.
     In Herdr, open the wherdr panel and press L for its log,
     or: herdr plugin log list --plugin $PLUGIN_ID"
  fi
  ok "wherdr answers on $URL"

  # ------------------------------------------------------------------ next
  # Already published on the tailnet and answering: that address is the one
  # to use (passkeys are tied to it); the plugin opened the guide there.
  ADDRESS="$(plugin_address)"
  say ""
  say "${G}${B}wherdr is running → $ADDRESS${R}"
  if [ "$ADDRESS" != "$URL" ]; then
    say "  Your private tailnet address, for this computer and your phone. Enable the"
    say "  passkey lock there (Settings › Security): a passkey is tied to its address."
    say "  ${D}Also on this computer: $URL${R}"
  elif [ "$BROWSER" = "1" ] && [ "$FIRST" = "1" ]; then
    say "  The setup guide is open in your browser; its Phone step makes wherdr"
    say "  reachable from your phone over Tailscale (private, never the Internet)."
  elif [ "$BROWSER" = "1" ]; then
    say "  Open it in your browser; Settings › Phone sets up your phone."
  else
    say "  No screen here: open it from this machine, or from your computer through"
    say "    ${C}ssh -L $PORT:127.0.0.1:$PORT $(id -un)@$(hostname 2>/dev/null || echo this-server)${R}"
    # In Docker, this script offers to publish wherdr on the tailnet itself.
    if [ "$CONTAINER" = "1" ]; then docker_phone; else phone_steps; fi
  fi
  key="$(panel_key)"
  if [ -n "$key" ]; then
    say "  In Herdr, ${B}$key${R} opens the wherdr panel: state, open, phone, start/stop, update."
  else
    say "  The wherdr panel: herdr plugin action invoke panel --plugin $PLUGIN_ID"
  fi
  say ""
  say "${D}Update: run this command again, or U in the wherdr panel.${R}"
  say "${D}Docs:   https://github.com/$REPO#readme${R}"
}

# The address the plugin opens: the tailnet one when wherdr is already
# published there and it answers, else the local one.
plugin_address() {
  a=""
  if [ -n "$PLUGIN_ROOT" ] && [ -f "$PLUGIN_ROOT/scripts/herdr-plugin.sh" ]; then
    a="$(WHERDR_DIR="$DIR" WHERDR_PORT="$PORT" sh "$PLUGIN_ROOT/scripts/herdr-plugin.sh" address 2>/dev/null || true)"
  fi
  case "$a" in https://*) printf '%s' "$a" ;; *) printf '%s' "$URL" ;; esac
}

# The Herdr key the plugin bound to its panel, empty when there is none.
panel_key() {
  [ -n "$PLUGIN_ROOT" ] && [ -f "$PLUGIN_ROOT/scripts/herdr-plugin.sh" ] || return 0
  k="$(WHERDR_DIR="$DIR" sh "$PLUGIN_ROOT/scripts/herdr-plugin.sh" key status 2>/dev/null || true)"
  [ "$k" = "none" ] || printf '%s' "$k"
}

# ------------------------------------------------------------ plugin path
find_herdr() {
  if [ -n "${HERDR_BIN:-}" ] && [ -x "$HERDR_BIN" ]; then echo "$HERDR_BIN"
  elif [ -x "$HOME/.local/bin/herdr" ]; then echo "$HOME/.local/bin/herdr"
  elif command -v herdr >/dev/null 2>&1; then command -v herdr
  else return 1
  fi
}

# Folder of the installed wherdr plugin, empty when it is not installed.
plugin_root() {
  "$HERDR" plugin list --plugin "$PLUGIN_ID" --json 2>/dev/null \
    | sed -n 's/.*"plugin_root":"\([^"]*\)".*/\1/p' | head -n 1
}

# Herdr installs the plugin and runs its build (scripts/herdr-plugin.sh build),
# which reads these variables. A local checkout (WHERDR_PLUGIN=/path) is linked
# and built in place instead.
plugin_install() {
  set -- env WHERDR_INSTALLER=1 WHERDR_DIR="$DIR" WHERDR_PORT="$PORT"
  [ -z "$MODE" ] || set -- "$@" WHERDR_MODE="$MODE"
  [ -z "$RUNTIME" ] || set -- "$@" WHERDR_RUNTIME="$RUNTIME"
  [ "$BROWSER" = "1" ] || set -- "$@" WHERDR_NO_BROWSER=1
  if [ -d "$PLUGIN" ]; then
    "$HERDR" plugin link "$PLUGIN" >/dev/null || return 1
    ok "Plugin linked from $PLUGIN"
    "$@" sh "$PLUGIN/scripts/herdr-plugin.sh" build
  elif [ -n "$REF" ]; then
    "$@" "$HERDR" plugin install "$PLUGIN" --ref "$REF" --yes
  else
    "$@" "$HERDR" plugin install "$PLUGIN" --yes
  fi
}

# Something answers on the port: never replaced. A wherdr of the plugin, or
# of a Docker folder of this script, can be updated; anything else is left as is.
existing_wherdr() {
  if ! is_wherdr; then
    die "Port $PORT is already used by another program.
     Pick another port: curl -fsSL https://wherdr.dev/install | WHERDR_PORT=7684 sh"
  fi
  ok "wherdr already runs on $URL"
  owner="$(container_dir)"
  if [ -n "$PLUGIN_ROOT" ] && [ -z "$owner" ]; then
    say "  Installed as a Herdr plugin."
    if confirm "Update it now (herdr plugin install $REPO)?"; then
      step "Updating the wherdr Herdr plugin"
      RUNTIME="" BROWSER=0
      log="$(mktemp)"
      if ! plugin_install >"$log" 2>&1; then
        sed 's/^/     /' "$log" >&2; rm -f "$log"
        die "The update failed. Its log: herdr plugin log list --plugin $PLUGIN_ID"
      fi
      rm -f "$log"
      ok "wherdr updated"
    else
      say "  Update later: U in the wherdr panel, or run this command again."
    fi
    say ""
    say "  On this machine: ${B}$URL${R}"
    phone_steps
    return 0
  elif [ -n "$owner" ]; then
    say "  It runs in Docker, from $owner."
    if [ "$(real_dir "$owner")" = "$(real_dir "$DIR")" ] && confirm "Update it now (docker compose pull && docker compose up -d)?"; then
      (cd "$DIR" && docker compose pull --quiet && docker compose up -d --remove-orphans >/dev/null)
      ok "wherdr updated"
      i=0
      while [ "$i" -lt 30 ] && ! answers; do i=$((i + 1)); sleep 1; done
    else
      say "  Update: cd $owner && docker compose pull && docker compose up -d"
    fi
    say ""
    say "  On this machine: ${B}$URL${R}"
    docker_phone
    return 0
  else
    say "  It was installed another way (npm, Homebrew, by hand): nothing changed."
    say "  Update it the same way: https://github.com/$REPO#updating"
    say "  Phone: ${C}wherdr phone${R} (or ${C}npx wherdr phone${R}) checks the address your phone opens."
  fi
  say ""
  say "  Open ${B}$URL${R}"
}

# The headless end of the install: the phone steps of the plugin
# (`wherdr phone`: Tailscale state, the address, the QR code once it answers).
phone_steps() {
  say ""
  if [ -n "$PLUGIN_ROOT" ] && [ -f "$PLUGIN_ROOT/scripts/herdr-plugin.sh" ]; then
    WHERDR_DIR="$DIR" sh "$PLUGIN_ROOT/scripts/herdr-plugin.sh" phone || true
  else
    say "  Phone: wherdr phone (in the wherdr panel: P)."
  fi
}

# No Node.js 22, no Bun (and no Docker on Linux).
no_runtime() {
  if [ "$OS" = "Darwin" ] && command -v brew >/dev/null 2>&1; then
    warn "wherdr needs Node.js 22 or newer (or Bun), and none was found."
    if confirm "Install Node.js with Homebrew now (brew install node)?"; then
      brew install node || die "brew install node failed."
      RUNTIME="$(find_runtime)" || die "Node.js was installed but is not found: open a new terminal and run this command again."
      ver="$("$RUNTIME" --version 2>/dev/null || true)"
      ok "Runtime: $RUNTIME ($ver)"
      return 0
    fi
    die "Install Node.js 22, then run this command again:
       ${C}brew install node${R}   (or https://nodejs.org)"
  elif [ "$OS" = "Darwin" ]; then
    die "wherdr needs Node.js 22 or newer (or Bun), and none was found.
     Install it from https://nodejs.org (or Homebrew: brew install node),
     then run this command again."
  else
    die "wherdr needs Node.js 22 or newer (or Bun), or Docker, and none is usable by $(id -un).
     Install one of them, then run this command again:
       Node.js: https://nodejs.org/en/download (nvm, fnm, or your package manager)
       Docker:  https://docs.docker.com/engine/install/"
  fi
}

# Node.js 22 or newer, or Bun: WHERDR_RUNTIME, the PATH, then the usual
# install folders (n, nvm, Volta, fnm, asdf, Homebrew, Bun).
find_runtime() {
  # ls | sort: the newest version first (paths under $HOME have no spaces to split).
  # shellcheck disable=SC2012
  for c in "${WHERDR_RUNTIME:-}" "$(command -v node 2>/dev/null || true)" \
    "$HOME/.n/bin/node" $(ls -d "$HOME"/.nvm/versions/node/v*/bin/node 2>/dev/null | sort -r) \
    "$HOME/.volta/bin/node" \
    $(ls -d "$HOME"/.local/share/fnm/node-versions/*/installation/bin/node "$HOME"/.fnm/node-versions/*/installation/bin/node 2>/dev/null | sort -r) \
    "$HOME/.asdf/shims/node" /opt/homebrew/bin/node /usr/local/bin/node /usr/bin/node \
    "$(command -v bun 2>/dev/null || true)" "$HOME/.bun/bin/bun" /opt/homebrew/bin/bun /usr/local/bin/bun; do
    [ -n "$c" ] && [ -x "$c" ] && [ ! -d "$c" ] || continue
    case "$(basename "$c")" in
      bun) if "$c" --version >/dev/null 2>&1; then echo "$c"; return 0; fi ;;
      *) if [ "$("$c" -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)" -ge 22 ] 2>/dev/null; then echo "$c"; return 0; fi ;;
    esac
  done
  return 1
}

# ------------------------------------------------------------- Docker
docker_usable() {
  command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1 && docker info >/dev/null 2>&1
}

real_dir() { (cd "$1" 2>/dev/null && pwd -P) || echo "$1"; }

# Compose folder of the `wherdr` container, empty when there is none.
container_dir() {
  command -v docker >/dev/null 2>&1 || return 0
  docker inspect wherdr --format '{{ index .Config.Labels "com.docker.compose.project.working_dir" }}' 2>/dev/null || true
}

# True when a `wherdr` container exists and belongs to another folder than
# $DIR: Compose would replace it (same project and container name).
container_elsewhere() {
  owner="$(container_dir)"
  [ -n "$owner" ] && [ "$(real_dir "$owner")" != "$(real_dir "$DIR")" ]
}

# WHERDR_MODE=docker: Docker Compose with the prebuilt image in $DIR, no plugin.
docker_install() {
  SOURCE="${WHERDR_SOURCE:-https://raw.githubusercontent.com/$REPO/${REF:-main}}"
  IMAGE="${WHERDR_IMAGE:-ghcr.io/afloury/wherdr:latest}"
  command -v docker >/dev/null 2>&1 \
    || die "Docker is not installed. Install Docker Engine first: https://docs.docker.com/engine/install/"
  docker compose version >/dev/null 2>&1 \
    || die "Docker Compose v2 (\`docker compose\`) is missing. Install the compose plugin: https://docs.docker.com/compose/install/linux/"
  if ! docker info >/dev/null 2>&1; then
    die "Cannot talk to the Docker daemon as $(id -un).
     Start Docker, or let your user use it (then log out and back in):
       sudo usermod -aG docker $(id -un)
     This script does not run sudo itself."
  fi
  ok "Docker $(docker version --format '{{.Server.Version}}' 2>/dev/null || echo '?'), $(docker compose version --short 2>/dev/null || echo 'compose v2')"
  if container_elsewhere; then
    die "A \"wherdr\" Docker container already exists, managed from $(container_dir).
     Update it from there: cd $(container_dir) && docker compose pull && docker compose up -d"
  fi
  if answers && [ -z "$(container_dir)" ]; then
    die "Something already answers on port $PORT (a wherdr installed another way?): nothing changed.
     Pick another port with WHERDR_PORT=7684."
  fi
  if [ "$HERDR" != "$HOME/.local/bin/herdr" ]; then
    warn "The container looks for Herdr in ~/.local/bin/herdr: HERDR_BIN=$HERDR is set in .env."
  fi

  step "Preparing $DIR"
  mkdir -p "$DIR"
  cd "$DIR"
  TMP="$(mktemp)"
  trap 'rm -f "$TMP"' EXIT INT TERM
  download "$SOURCE/docker-compose.yml" "$TMP" \
    || die "Could not download docker-compose.yml from $SOURCE."
  if [ ! -f docker-compose.yml ]; then
    mv "$TMP" docker-compose.yml
    ok "docker-compose.yml (${REF:-main})"
  elif cmp -s "$TMP" docker-compose.yml; then
    ok "docker-compose.yml is up to date"
  elif confirm "docker-compose.yml differs from the ${REF:-main} version. Replace it (a backup is kept)?"; then
    cp docker-compose.yml docker-compose.yml.bak
    mv "$TMP" docker-compose.yml
    ok "docker-compose.yml replaced (previous one: docker-compose.yml.bak)"
  else
    ok "Keeping your docker-compose.yml"
  fi

  if [ -f .env ]; then
    ok ".env kept as it is"
  else
    {
      echo "# wherdr settings, read by docker compose (see .env.example in the repository)."
      echo "HOST_HOME=$HOME"
      echo "PUID=$(id -u)"
      echo "PGID=$(id -g)"
      echo "PORT=$PORT"
      echo "# Private HTTPS address (tailscale serve), needed for push notifications."
      echo "APP_URL=http://localhost:$PORT/"
      echo "HOST_LABEL=$(short_host)"
      echo "TZ=$(local_tz)"
      if [ "$HERDR" != "$HOME/.local/bin/herdr" ]; then echo "HERDR_BIN=$HERDR"; fi
      if [ "$IMAGE" != "ghcr.io/afloury/wherdr:latest" ]; then echo "WHERDR_IMAGE=$IMAGE"; fi
    } > .env
    ok ".env created"
  fi

  # Created as this user before Compose runs: otherwise Docker creates the
  # missing bind-mount folders as root and the container cannot write them.
  mkdir -p data "$HOME/.config/herdr" "$HOME/.local/state/herdr/client" \
    "$HOME/.cache/herdr-web" "$HOME/.herdr-projects"
  ok "Data folders ready"

  step "Starting wherdr"
  if ! docker compose pull --quiet 2>"$TMP"; then
    sed 's/^/     /' "$TMP" >&2
    die "Could not pull the wherdr image ($IMAGE).
     If it is not published yet, build it from source instead:
       git clone https://github.com/$REPO.git && cd wherdr
       docker compose -f docker-compose.yml -f docker-compose.build.yml up -d --build
     Your $DIR folder and .env are kept: run this script again later."
  fi
  ok "Image pulled"
  docker compose up -d --remove-orphans >/dev/null
  ok "Container started"

  i=0
  while [ "$i" -lt 30 ] && ! answers; do i=$((i + 1)); sleep 1; done
  if answers; then
    ok "wherdr answers on $URL"
  else
    warn "wherdr does not answer on 127.0.0.1:$PORT yet. Check: cd $DIR && docker compose logs"
  fi

  say ""
  say "${G}${B}wherdr is running.${R} On this machine: ${B}$URL${R}"
  docker_phone
  say ""
  say "${D}Update: cd $DIR && docker compose pull && docker compose up -d${R}"
  say "${D}Docs:   https://github.com/$REPO#readme${R}"
}

# "<machine>.<tailnet>.ts.net[:port]" of the address `tailscale serve`
# publishes for wherdr's local port, empty when there is none.
served_host() {
  host="$(tailscale serve status --json 2>/dev/null | tr '{,' '\n\n' | awk -v port="$PORT" '
    /"[^"]*:[0-9]+"[ \t]*:[ \t]*$/ { key = $0; sub(/^[^"]*"/, "", key); sub(/".*$/, "", key) }
    /"Proxy"/ && $0 ~ ("\"(https?://)?(127\\.0\\.0\\.1|localhost):" port "/?\"") { print key; exit }')"
  printf '%s\n' "${host%:443}"
}

# The phone address of a wherdr in Docker. The container has no `tailscale`
# command; this script, on the host, has. wherdr adopts what `tailscale serve`
# publishes for its port by itself, through Tailscale's socket mounted by
# docker-compose.yml. So: publish it when it is not (asked first; private to
# the tailnet), hand the address to wherdr (a container started from an older
# compose file has no socket), and check that it answers.
docker_phone() {
  publish="tailscale serve --bg --https=$PORT http://127.0.0.1:$PORT"
  say ""
  say "${B}Your phone${R} (private network only, never the public Internet):"
  if ! command -v tailscale >/dev/null 2>&1; then
    say "  1. Install Tailscale on this machine and your phone (same account), with HTTPS"
    say "     certificates enabled: https://tailscale.com/download"
    say "  2. ${C}$publish${R}"
    say "  3. Open the https://<machine>.<tailnet>.ts.net:$PORT/ address on the phone: wherdr"
    say "     enables it by itself. Add it to the home screen, enable notifications."
    say "  4. Settings → Security → Enable passkey lock (first token: ${C}docker compose logs${R})."
    return 0
  fi
  name="$(tailscale status --json 2>/dev/null | sed -n 's/.*"DNSName": *"\([^"]*\)\.".*/\1/p' | head -n 1)"
  if [ -z "$name" ]; then
    warn "Tailscale is not connected on this machine: run tailscale up, then this script again."
    return 0
  fi
  host="$(served_host)"
  if [ -z "$host" ] && confirm "Publish wherdr on your tailnet now ($publish)? Only your Tailscale devices reach it."; then
    # Without HTTPS on the tailnet, `tailscale serve` prints a link and waits.
    limit=""
    if command -v timeout >/dev/null 2>&1; then limit="timeout 30"; fi
    if out="$($limit tailscale serve --bg "--https=$PORT" "http://127.0.0.1:$PORT" 2>&1)"; then
      host="$(served_host)"
    else
      printf '%s\n' "$out" | sed 's/^/     /' >&2
      warn "tailscale serve failed. Not allowed? Run once: sudo tailscale set --operator=\$USER"
    fi
  fi
  if [ -z "$host" ]; then
    say "  Publish wherdr on your tailnet (only your Tailscale devices reach it):"
    say "    ${C}$publish${R}"
    say "  Then open ${B}https://$name:$PORT/${R} on the phone: wherdr enables that address by itself."
    return 0
  fi
  phone="https://$host/"
  post_address "$phone"
  i=0
  while [ "$i" -lt 12 ] && ! wherdr_at "$phone"; do
    if [ "$i" -eq 0 ]; then say "  Waiting for $phone (a new address takes up to a minute: HTTPS certificate)…"; fi
    i=$((i + 1)); sleep 5
    post_address "$phone"
  done
  if wherdr_at "$phone"; then
    ok "${B}$phone${R} answers"
    if command -v qrencode >/dev/null 2>&1; then qrencode -t ANSIUTF8 -m 2 "$phone"; fi
    say "  Open it on the phone, add it to the home screen, then in the app:"
    say "  Settings → Enable notifications, then Security → Enable passkey lock"
    say "  (first token: ${C}cd $DIR && docker compose logs${R})."
  elif [ "$(phone_reach "$phone")" = host ]; then
    warn "wherdr answers on $phone but refuses that address."
    say "     Restart it: ${C}cd $DIR && docker compose up -d --force-recreate${R}"
    say "     (wherdr reads Tailscale when it starts), then run this script again."
  else
    warn "$phone is published but does not answer like wherdr yet."
    say "     A new address takes up to a minute (HTTPS certificate): run this script again then."
  fi
}

# Hands the phone address to the local wherdr (POST /api/phone, accepted from
# this machine only): it checks it and sets APP_URL.
post_address() {
  body="{\"action\":\"address\",\"url\":\"$1\"}"
  if [ "$FETCH" = "curl" ]; then
    curl -s -o /dev/null --max-time 20 -H 'content-type: application/json' -d "$body" "http://127.0.0.1:$PORT/api/phone" 2>/dev/null || true
  else
    wget -q -O /dev/null -T 20 --header='content-type: application/json' --post-data="$body" "http://127.0.0.1:$PORT/api/phone" 2>/dev/null || true
  fi
}

# Does the phone address answer? "ok" (wherdr, and it accepts that address),
# "host" (wherdr refuses that address), or "none". /api/health goes through
# wherdr's host check; the static manifest answers for any host name and only
# recognizes a wherdr older than that route.
phone_reach() {
  if [ "$FETCH" = "curl" ]; then
    body="$(curl -s --max-time 8 "${1}api/health" 2>/dev/null || true)"
    case "$body" in
      *'"name":"wherdr"'*) echo ok; return 0 ;;
      *'"code":"host"'*) echo host; return 0 ;;
    esac
    if curl -fs --max-time 8 "${1}manifest.webmanifest" 2>/dev/null | grep -q '"wherdr"'; then echo ok; else echo none; fi
  else
    # wget prints no body for an error: the status line tells a refusal (403).
    if wget -q -O - -T 8 "${1}api/health" 2>/dev/null | grep -q '"wherdr"'; then echo ok; return 0; fi
    if wget -S -q -O /dev/null -T 8 "${1}api/health" 2>&1 | grep -q 'HTTP/[0-9.]* 403'; then echo host; return 0; fi
    if wget -q -O - -T 8 "${1}manifest.webmanifest" 2>/dev/null | grep -q '"wherdr"'; then echo ok; else echo none; fi
  fi
}
wherdr_at() { [ "$(phone_reach "$1")" = ok ]; }

# ------------------------------------------------------------- helpers
setup_colors() {
  if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    B="$(printf '\033[1m')"; D="$(printf '\033[2m')"; R="$(printf '\033[0m')"
    G="$(printf '\033[32m')"; Y="$(printf '\033[33m')"; E="$(printf '\033[31m')"; C="$(printf '\033[36m')"
  else
    B=""; D=""; R=""; G=""; Y=""; E=""; C=""
  fi
}
say() { printf '%s\n' "$*"; }
step() { printf '\n%s==>%s %s%s%s\n' "$C" "$R" "$B" "$*" "$R"; }
ok() { printf '  %s✓%s %s\n' "$G" "$R" "$*"; }
warn() { printf '  %s⚠%s %s\n' "$Y" "$R" "$*" >&2; }
die() { printf '\n  %s✗ %s%s\n\n' "$E" "$*" "$R" >&2; exit 1; }

# Questions read the terminal: stdin is the script itself with `curl … | sh`.
# No terminal and no WHERDR_YES: the answer is no (nothing is changed).
confirm() {
  if [ "$YES" = "1" ]; then return 0; fi
  # In a subshell: a failed redirection on a special builtin would exit the script.
  if ! (exec </dev/tty) 2>/dev/null; then
    warn "$1 — no terminal to ask, answering no (set WHERDR_YES=1 to accept)."
    return 1
  fi
  printf '  ? %s [y/N] ' "$1" >/dev/tty
  read -r answer </dev/tty || answer=""
  case "$answer" in [yY]|[yY][eE][sS]) return 0 ;; *) return 1 ;; esac
}
download() {
  if [ "$FETCH" = "curl" ]; then curl -fsSL "$1" -o "$2"; else wget -q -O "$2" "$1"; fi
}
# Any HTTP answer counts (a locked wherdr answers 401): the port is taken.
answers() {
  if [ "$FETCH" = "curl" ]; then
    code="$(curl -s -o /dev/null --max-time 2 -w '%{http_code}' "http://127.0.0.1:$PORT/" 2>/dev/null || true)"
    [ -n "$code" ] && [ "$code" != "000" ]
  else
    # wget fails on an error status (and its exit code varies): read the status line.
    wget -S -q -O /dev/null -T 2 "http://127.0.0.1:$PORT/" 2>&1 | grep -q 'HTTP/[0-9.]* [0-9]'
  fi
}
# The web app manifest names wherdr (it is served without a session).
is_wherdr() {
  if [ "$FETCH" = "curl" ]; then
    curl -fs --max-time 3 "http://127.0.0.1:$PORT/manifest.webmanifest" 2>/dev/null | grep -q '"wherdr"'
  else
    wget -q -O - -T 3 "http://127.0.0.1:$PORT/manifest.webmanifest" 2>/dev/null | grep -q '"wherdr"'
  fi
}

# version_lt A B: true when version A < B (numeric dot-separated parts).
version_lt() {
  [ "$1" = "$2" ] && return 1
  lowest="$(printf '%s\n%s\n' "$1" "$2" | sort -t. -k1,1n -k2,2n -k3,3n | head -n 1)"
  [ "$lowest" = "$1" ]
}

# The machine's short name (no domain): what the app shows, and the container's
# host name. Without it the container would be called "wherdr".
short_host() {
  h="$(hostname 2>/dev/null | cut -d. -f1)"
  echo "${h:-server}"
}

local_tz() {
  if [ -n "${TZ:-}" ]; then echo "$TZ"
  elif [ -r /etc/timezone ]; then head -n 1 /etc/timezone
  elif [ -L /etc/localtime ]; then readlink /etc/localtime | sed 's#.*/zoneinfo/##'
  else echo UTC
  fi
}

main "$@"
