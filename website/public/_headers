# Response headers of the Cloudflare Workers static assets (wrangler.jsonc).
# Same rules as nginx.conf, the private deployment. Not served itself.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'

# `curl -fsSL https://wherdr.dev/install | sh`: a plain-text shell script,
# always fresh. The file has no extension, so its type is set here.
/install
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache

# Plain-text guides for coding agents and LLMs (/agent.md, /llms.txt).
/agent.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: no-cache

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache

# Fingerprinted build output.
/_nuxt/*
  Cache-Control: public, max-age=31536000, immutable

