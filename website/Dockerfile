# wherdr.dev: static site generated by Nuxt, served by nginx.
FROM --platform=$BUILDPLATFORM node:22-alpine AS build
WORKDIR /site
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund --ignore-scripts
COPY . .
# The Pi has 4 GB of RAM: cap the Node heap during the build.
RUN NODE_OPTIONS=--max-old-space-size=1536 npm run generate

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /site/.output/public /usr/share/nginx/html
EXPOSE 80
