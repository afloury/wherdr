# Installation settings, read by docker compose. Copy to `.env` (not tracked by git).
# Before Docker: mkdir -p data "$HOME/.config/herdr" "$HOME/.local/state/herdr/client" "$HOME/.cache/herdr-web"
# Then: cp .env.example .env; fill in PUID, PGID, APP_URL; docker compose up -d (image published on ghcr.io)
# Docker is meant for a Linux host: on macOS, Docker Desktop cannot reach Herdr's Unix
# socket; run wherdr natively there (see the end of this file).

# Home directory of the host user (mounted at the same path in the container).
# Default: $HOME of the user running docker compose.
# HOST_HOME=/home/<user>
# UID/GID of that user (`id -u`, `id -g`).
PUID=1000
PGID=1000
# Listening port (127.0.0.1 only; published by `tailscale serve`).
PORT=7683
# Private HTTPS address of the app (subject of Web Push notifications).
# Local test: APP_URL=http://localhost:7683/; the server starts, but Web Push is disabled.
# Passkeys/PWA on another device require HTTPS: use tailscale serve (private network).
APP_URL=https://server.example.ts.net:7683/
# Machine name shown in the app; empty = host name (wherdr in Docker).
HOST_LABEL=
# Other DNS names allowed to open the app, comma-separated.
# The APP_URL host, localhost and the machine's addresses are already allowed.
# HERDR_WEB_ALLOWED_HOSTS=server.lan,server.example.ts.net
# The first passkey requires a token printed in the logs at startup: docker logs herdr-web
# The app stays usable without a passkey on the private network.
# User name stored with the passkeys (Face ID / Touch ID).
PASSKEY_USER=wherdr
# Fuseau horaire (heures de la conversation, journaux).
TZ=UTC
# Herdr binary, if not in $HOST_HOME/.local/bin/herdr.
# HERDR_BIN=
# Agent kinds offered.
# Optional: restrict the agents offered (only installed ones are shown).
# AGENT_KINDS=claude,codex,kimi,gemini,opencode
# SSH machines registered in Herdr (`herdr machine list`): `off` to stick to this one.
# HERDR_WEB_MACHINES=on
# Other names / IPs of this machine (Herdr profiles pointing at it are ignored), comma-separated.
# HERDR_WEB_SELF_HOSTS=100.x.y.z,server.example.ts.net

# Running without Docker (Node.js 22, Herdr and git installed on the same host):
# npm ci && npm run build && npm start   (listens on 127.0.0.1:7683 by default)
# APP_URL=https://server.example.ts.net:7683/ DATA_DIR="$PWD/data" npm start
# HOME and HERDR_BIN are read from the current environment; set HERDR_WEB_SESSION if needed.

# Updates: "new version" notice in the app (one request per day to GitHub releases).
# WHERDR_UPDATE_CHECK=off
# Image pinned to a version instead of latest.
# WHERDR_IMAGE=<image>:1.2.0   (default image: see docker-compose.yml)
