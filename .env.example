# Native environment settings (or KEY=VALUE lines in ~/wherdr/wherdr.env).
# Listening port (127.0.0.1 only; published by `tailscale serve`).
PORT=7683
# Private HTTPS address of the app (subject of Web Push notifications).
# With Tailscale, leave http://localhost:7683/: wherdr adopts by itself the address
# `tailscale serve` publishes for its port (saved in data/app-url.json). Set an
# https:// address here only for another private network: it then always wins.
# Passkeys/PWA on another device require HTTPS: use tailscale serve (private network).
APP_URL=http://localhost:7683/
# Machine name shown in the app (empty = this machine's hostname).
HOST_LABEL=
# Other DNS names allowed to open the app, comma-separated.
# The APP_URL host, localhost and the machine's addresses are already allowed.
# HERDR_WEB_ALLOWED_HOSTS=server.lan,server.example.ts.net
# The app stays usable without a passkey on the private network.
# User name stored with the passkeys (Face ID / Touch ID).
PASSKEY_USER=wherdr
# Time zone for conversation timestamps and logs.
TZ=UTC
# Herdr binary when it is not in ~/.local/bin or PATH.
# HERDR_BIN=
# Agent kinds offered.
# Optional: restrict the agents offered (only installed ones are shown).
# AGENT_KINDS=claude,codex,kimi,gemini,opencode
# SSH machines registered in Herdr (`herdr machine list`): `off` to stick to this one.
# HERDR_WEB_MACHINES=on
# Other names / IPs of this machine (Herdr profiles pointing at it are ignored), comma-separated.
# HERDR_WEB_SELF_HOSTS=100.x.y.z,server.example.ts.net


# Updates: "new version" notice in the app (one request per day to GitHub releases).
# WHERDR_UPDATE_CHECK=off
