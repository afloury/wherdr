{
  "name": "wherdr",
  "version": "1.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Unofficial mobile web client (PWA) to drive the coding agents running in Herdr",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "HOST=${HOST:-127.0.0.1} PORT=${PORT:-7683} node .output/server/index.mjs",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "postinstall": "nuxt prepare",
    "check:leaks": "node scripts/check-leaks.mjs",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@nuxt/ui": "^4.11.2",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "dompurify": "^3.4.16",
    "marked": "^15.0.12",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.136",
    "@nuxt/test-utils": "^4.3.3",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/web-push": "^3.6.4",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.0.0"
  }
}
